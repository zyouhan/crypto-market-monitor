# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# 至少 32 位随机字符串
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# 服务配置
PORT=4000
HOST=0.0.0.0

# 生产环境：HTTP 访问必须为 false；启用 HTTPS 后改为 true
COOKIE_SECURE=false

# 生产环境填浏览器实际访问地址，必须完全一致（不要带结尾斜杠）
# 例如 http://203.0.113.10 或 https://monitor.example.com
FRONTEND_ORIGIN=http://localhost:3000

# SQLite
DATABASE_PATH=./data/crypto-market-monitor.db

# Binance USD-M Futures
BINANCE_BASE_URL=https://fapi.binance.com

# 扫描节拍（毫秒）：worker 多久检查一次“哪些标的该拉取了”。
# 实际请求频率由每个标的的 K 线周期决定（1m 约 1 次/分钟，5m 约 1 次/5 分钟）。
# 生产建议 15000；想减少 1m 标的请求量可调到 120000/180000（会增加信号延迟）。
POLL_INTERVAL_MS=10000

# 同时拉取的标的数量上限（1-10），避免标的增多后串行请求拖长一轮
MAX_CONCURRENT_SYMBOLS=3

# 每次请求获取的 K 线数量，同时是 EMA 慢线 / KDJ 周期的上限
KLINE_LIMIT=300

# 本地开发使用 SOCKS5 代理时填写
# 生产 VPS 直连 Binance 时留空
PROXY_URL=

# Server酱
SERVERCHAN_SENDKEY=

# 全局微信通知开关
GLOBAL_WECHAT_ENABLED=false
