# 管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# 至少 32 位随机字符串
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# 服务配置
PORT=4000
HOST=0.0.0.0

# 生产环境：HTTP 访问必须为 false；启用 HTTPS 后改为 true
COOKIE_SECURE=false

# 生产环境填浏览器实际访问地址，必须完全一致（不要带结尾斜杠）
# 例如 http://203.0.113.10 或 https://monitor.example.com
FRONTEND_ORIGIN=http://localhost:3000

# SQLite
DATABASE_PATH=./data/crypto-market-monitor.db

# 行情数据源：OKX 优先，失败后回退 Binance
OKX_BASE_URL=https://www.okx.com
BINANCE_BASE_URL=https://fapi.binance.com

# 扫描节拍（毫秒）：worker 多久检查一次“哪些监控项该拉取了”。
# 实际请求频率由每个监控项的入场周期决定。
POLL_INTERVAL_MS=10000

# 同时处理的监控项数量上限（1-10）
MAX_CONCURRENT_SYMBOLS=3

# 每次请求获取的 K 线数量
KLINE_LIMIT=300

# 本地开发使用 SOCKS5 代理时填写
# 生产 VPS 直连 OKX / Binance 时留空
PROXY_URL=

# Server酱
SERVERCHAN_SENDKEY=

# 全局微信通知开关
GLOBAL_WECHAT_ENABLED=false
