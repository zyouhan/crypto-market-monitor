{
  "name": "crypto-market-monitor-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Crypto Market Monitor desktop shell",
  "author": "Crypto Market Monitor",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.crypto.marketmonitor",
    "productName": "Crypto Market Monitor",
    "asar": true,
    "npmRebuild": false,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config.json",
        "to": "app-config.json"
      }
    ],
    "directories": {
      "output": "dist"
    }
  }
}
