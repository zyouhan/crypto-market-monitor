{
    "name": "crypto-market-monitor",
    "private": true,
    "workspaces": [
        "apps/server",
        "apps/web"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
        "dev:server": "npm run dev --workspace=crypto-market-monitor-server",
        "dev:web": "npm run dev --workspace=crypto-market-monitor-web",
        "build": "npm run build -w apps/server && npm run build -w apps/web",
        "desktop:install": "node scripts/install-desktop.cjs",
        "desktop:dev": "npm run desktop:install && npm run dev --prefix apps/desktop",
        "desktop:pack": "node scripts/package-desktop.cjs --dir",
        "desktop:pack:next": "node scripts/package-desktop.cjs --dir --config.directories.output=dist-next",
        "typecheck": "npm run typecheck -w apps/server && npm run typecheck -w apps/web"
    },
    "devDependencies": {
        "concurrently": "^9.1.2"
    }
}