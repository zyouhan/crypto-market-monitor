{
    "name": "crypto-market-monitor",
    "private": true,
    "workspaces": [
        "apps/server",
        "apps/web"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
        "dev:server": "npm run dev --workspace=crypto-market-monitor-server",
        "dev:web": "npm run dev --workspace=crypto-market-monitor-web",
        "build": "npm run build -w apps/server && npm run build -w apps/web"
    },
    "devDependencies": {
        "concurrently": "^9.1.2"
    }
}